import React from "react";

/**
 * Converts standard SAN move strings (e.g. "Nf3", "Bxb5+") into Lichess
 * figurative notation ("♘f3", "♗xb5+") used in the PV strip.
 */
export function toFigurativeSan(san: string): string {
  return san
    .replace(/^K/, "♔")
    .replace(/^Q/, "♕")
    .replace(/^R/, "♖")
    .replace(/^B/, "♗")
    .replace(/^N/, "♘");
}

/**
 * Authentic Cburnett vector SVG chess pieces matching Lichess's default piece set.
 * License: BSD / GPL / CC-BY-SA-3.0 by Colin M.L. Burnett.
 */
export const CburnettPiece: React.FC<{
  color: "w" | "b";
  type: "p" | "n" | "b" | "r" | "q" | "k";
  className?: string;
}> = ({ color, type, className = "" }) => {
  const key = `${color}${type}`;

  switch (key) {
